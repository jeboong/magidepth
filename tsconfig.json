{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "skipLibCheck": true, "moduleResolution": "Bundler", "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "isolatedModules": true,
    "esModuleInterop": true, "noEmit": true, "jsx": "react-jsx", "strict": true,
    "baseUrl": ".", "paths": {"@/*": ["src/*"]}, "types": ["vite/client", "node"]
  },
  "include": ["src", "shared", "electron", "vite.config.ts"]
}
