{
  "name": "magidepth",
  "version": "0.3.3",
  "description": "MagiMagic — local depth maps and face-grid magic in one workspace.",
  "private": true,
  "main": "app-desktop/main.cjs",
  "author": "MagiMagic contributors",
  "license": "MIT",
  "homepage": "https://github.com/jeboong/magidepth",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeboong/magidepth.git"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "vite --host 127.0.0.1",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run desktop:build",
    "build:icon": "node scripts/build-icon.mjs",
    "prepare:resources": "node scripts/prepare-resources.mjs",
    "dist:win": "npm run prepare:resources && npm run build && electron-builder --win nsis --x64 --publish never",
    "pack:win": "npm run prepare:resources && npm run build && electron-builder --win dir --x64 --publish never",
    "test": "node --test tests/*.test.mjs",
    "test:backend": "python -m unittest discover -s backend/tests -v"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.magidepth.app",
    "productName": "MagiMagic",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "app-desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!tests/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "resources",
        "to": "runtime-assets",
        "filter": [
          "python-embed.zip",
          "pip.whl",
          "manifest.json"
        ]
      },
      {
        "from": "LICENSE",
        "to": "licenses/MagiDepth-LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "MagiMagic-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MagiMagic",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jeboong",
        "repo": "magidepth",
        "releaseType": "release"
      }
    ]
  }
}
